    color: #00FF41;
}

App.-phosphor DataTable > .datatable--cursor {
    background: #00FF41;
    color: #000000;
    text-style: bold;
}

App.-phosphor DataTable > .datatable--hover {
    background: #001A08;
}

App.-phosphor Footer {
