/* layout only — colors live on App.-cassette / App.-cyberpunk */

Screen {
    layout: vertical;
    overflow: hidden;
}

#title-bar {
    dock: top;
    height: 1;
    text-style: bold;
    padding: 0 1;
}

#chrome {
    height: 1;
    padding: 0 1;
}

#scan {
    height: 1;
    padding: 0 1;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#menu-pane {
    width: 1fr;
}

#logo-pane {
    width: 1fr;
    align: center middle;
}

#logo {
    width: auto;
    height: auto;
    padding: 1 2;
}

.pane-title {
    text-style: bold;
    height: 1;
    padding: 0 1;
}

DataTable {
    height: 1fr;
}

#snake-wrap,
#game-wrap {
    height: 1fr;
}

#snake-hud,
#game-hud {
    height: 1;
    text-style: bold;
    padding: 0 1;
}

#snake-board,
#game-board {
    height: 1fr;
    padding: 1 2;
}

/* --- Cassette Futurism: black CRT, high-contrast amber phosphor --- */

App.-cassette {
    background: #000000;
    color: #FFF8C8;
}

App.-cassette #title-bar {
    background: #000000;
    color: #FFF8C8;
    text-style: bold;
}

App.-cassette #chrome {
    background: #000000;
    color: #FF9A40;
}

App.-cassette #scan {
    background: #000000;
    color: #3A2400;
}

App.-cassette #menu-pane,
App.-cassette #logo-pane,
App.-cassette #snake-wrap,
App.-cassette #game-wrap {
    background: #000000;
    border: tall #FFF8C8;
}

App.-cassette .pane-title,
App.-cassette #snake-hud,
App.-cassette #game-hud {
    background: #1A1200;
    color: #FFF8C8;
}

App.-cassette DataTable {
    background: #000000;
    color: #FFF8C8;
}

App.-cassette DataTable > .datatable--cursor {
    background: #FFF8C8;
    color: #000000;
    text-style: bold;
}

App.-cassette DataTable > .datatable--hover {
    background: #1A1200;
}

App.-cassette Footer {
    background: #000000;
    color: #FFF8C8;
}

App.-cassette #snake-board,
App.-cassette #game-board {
    background: #000000;
    color: #FFF8C8;
}

/* --- Cassette Phosphor: Nostromo CRT — black field, bright P1 green --- */

App.-phosphor {
    background: #000000;
    color: #00FF41;
}

App.-phosphor #title-bar {
    background: #000000;
    color: #00FF41;
    text-style: bold;
}

App.-phosphor #chrome {
    background: #000000;
    color: #00FF41;
}

App.-phosphor #scan {
    background: #000000;
    color: #007A22;
}

App.-phosphor #menu-pane,
App.-phosphor #logo-pane,
App.-phosphor #snake-wrap,
App.-phosphor #game-wrap {
    background: #000000;
    border: tall #00FF41;
}

App.-phosphor .pane-title,
App.-phosphor #snake-hud,
App.-phosphor #game-hud {
    background: #001A08;
    color: #00FF41;
