    color: #00FF41;
}

App.-phosphor #snake-board,
App.-phosphor #game-board {
    background: #000000;
    color: #00FF41;
}

/* --- Sci-Fi Blue: black CRT + ice bloom (halo field, not flat navy) --- */

App.-cyberpunk {
    background: #000000;
    color: #E8F7FF;
}

